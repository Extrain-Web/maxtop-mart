{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "maxtop-mart-server", "run", "start:dev"],
      "port": 5000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "maxtop-mart-client", "run", "dev"],
      "port": 3000
    },
    {
      "name": "server-hrtest",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "maxtop-mart-server", "run", "start:dev"],
      "port": 5055
    },
    {
      "name": "client-hrtest",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/with-env.cjs",
        "NEXT_PUBLIC_API_URL=http://localhost:5055/api",
        "--",
        "npm",
        "--prefix",
        "maxtop-mart-client",
        "run",
        "dev",
        "--",
        "--port",
        "3010"
      ],
      "port": 3010
    }
  ]
}
